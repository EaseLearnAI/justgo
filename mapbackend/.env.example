# Just Go! mapbackend 环境变量示例
# 复制为 .env 后填写真实值；勿将 .env 提交入库

PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/justgo
JWT_SECRET=change-me-in-production

# 高德 Web 服务 Key（IP / 地理编码 / POI / 路径）
AMAP_MAPS_API_KEY=

# 大模型（ModelScope 等）
AI_API_KEY=
# AI_BASE_URL=https://api-inference.modelscope.cn/v1
# AI_MODEL=Qwen/Qwen3-Next-80B-A3B-Instruct
# VISION_MODEL=Qwen/Qwen3-VL-30B-A3B-Thinking

# 本地开发：模拟城市（避免内网 IP 总落到北京）
# MOCK_CITY=杭州
# MOCK_ADCODE=330100
# MOCK_LAT=30.2741
# MOCK_LNG=120.1551

# L0 兜底城
# DEFAULT_CITY=北京
# DEFAULT_ADCODE=110000
# DEFAULT_LAT=39.908823
# DEFAULT_LNG=116.397470
